{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/telemetry",
        "function": {
          "functionId": "telemetryIngest",
          "region": "asia-south1"
        }
      }
    ],
    "site": "chaicloud-workshop"
  },
  "emulators": {
    "firestore": {
      "port": 8185
    },
    "auth": {
      "port": 9195
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "telemetry",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.log",
        ".secret.local"
      ]
    }
  ]
}
